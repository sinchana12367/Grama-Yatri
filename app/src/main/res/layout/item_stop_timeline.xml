<?xml version="1.0" encoding="utf-8"?>
<!--
  Timeline item layout.
  Left column: dot + vertical connector line (creates the stepper effect).
  Right column: village name, ETA, absolute time, reporter attribution.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp">

    <!-- Timeline column -->
    <LinearLayout
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Dot -->
        <View
            android:id="@+id/view_dot"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/circle_dot"
            android:backgroundTint="@color/green_primary" />

        <!-- Vertical connector line -->
        <View
            android:id="@+id/view_connector"
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:background="@color/divider_color" />
    </LinearLayout>

    <!-- Content column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

        <!-- Village name -->
        <TextView
            android:id="@+id/tv_village_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <!-- ETA label (e.g. "~12 mins", "Bus passed", "Cancelled") -->
        <TextView
            android:id="@+id/tv_eta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:textColor="@color/green_primary"
            android:layout_marginTop="2dp" />

        <!-- Absolute time (e.g. "10:35 AM") -->
        <TextView
            android:id="@+id/tv_absolute_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginTop="1dp"
            android:visibility="gone" />

        <!-- Reporter attribution -->
        <TextView
            android:id="@+id/tv_reporter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:fontFamily="monospace"
            android:layout_marginTop="2dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
